# 复制为 .env 后按需填写；不要提交真实密钥

# ---- 模型 ----
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_MAID=
# Ollama：本仓库的服务读 OLLAMA_BASE；OLLAMA_BASE_URL 由 AstrBot 自身读取
OLLAMA_BASE=http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---- 服务端口（留空则读取 service.json）----
HUB_PORT=23408

# ---- 本地服务地址（默认值即可，一般不用改）----
# model 层；MODEL_URL 填了会优先于 MODEL_PORT
MODEL_PORT=23406
MODEL_URL=
# subtitle 能力服务（看视频 / 识图）
SUBTITLE_URL=http://127.0.0.1:23405

# ---- DeepSeek Harness（桌宠 / 模型路由）----
# 不填则用 %USERPROFILE%\.dsh；DSH_NODE 不填则用 PATH 里的 node
DSH_HOME=
DSH_NODE=

# ---- CosyVoice TTS ----
COSYVOICE_PORT=8714
COSYVOICE_URL=http://127.0.0.1:8714
# 下面两个路径必须改成你的实际目录（cosyvoice_tts_server.py 不接受留空）
# COSYVOICE_MODEL_DIR=C:\path\to\dafeiyu\cosyvoice_models\CosyVoice2-0.5B
# COSYVOICE_REPO_DIR=C:\path\to\dafeiyu\CosyVoice

# ---- QQ / NapCat ----
# NapCat OneBot HTTP 端口与 token（token 也可在 napcat 配置里设置）
ONEBOT_TOKEN=

# ---- 主动私聊后的监听窗口 ----
# 单位：秒。主动私聊成功后，原群 AI 在这段时间内继续监听该用户私聊。
LISTEN_WINDOW_SECONDS=300
