        }
    },
    "tools": {
        "disabled": [
            "tool-plugin-manager",
            "tool-working-directory",
            "tool-pwsh",
            "tool-bash",
            "tool-jobs",
            "tool-fs",
            "tool-fs-search",
            "tool-skill",
            "tool-subagent",
            "tool-subagent-fork",
            "tool-subagent-control",
            "tool-subagent-list-agents",
            "tool-workflow",
            "tool-todo",
            "tool-goal",
            "tool-web",
            "mcp-resources",
            "agent-instructions",
            "skill",
            "skill-filesystem",
            "hmr",
            "plan-mode"
        ]
    },
    "roles": {
        "大肥鱼": {
            "display": "大肥鱼",
            "profile": "brain-dafeiyu",
            "credential": {
                "mode": "account"
            },
            "model": "deepseek-flash",
            "reasoning_effort": "high",
            "persona_files": [
                "stack/persona-大肥鱼.md"
            ],
            "workspace": "services/brain/workspaces/brain-dafeiyu"
        },
        "桌宠": {
            "display": "桌宠",
