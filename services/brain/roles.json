        "qq": "大肥鱼",
        "wechat": "女仆"
    },
    "admins": {
        "qq": [],
        "wechat": []
    },
    "identities": [],
    "harness": {
        "dsh_root": "dsh",
        "dsh_home": "",
        "timeout_s": 180,
        "max_parallel": 3,
        "dotenv": [
            ".env",
            "services/brain/.env"
        ],
        "persona_drop_sections": [
            "用虚拟手机逛 App",
            "语音与行动"
        ],
        "memory": {
