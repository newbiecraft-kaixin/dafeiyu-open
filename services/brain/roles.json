{
  "default_role": "大肥鱼",
  "platform_defaults": {
    "qq": "大肥鱼",
    "wechat": "女仆"
  },
  "admins": {
    "qq": ["1000000000"],
    "wechat": ["wxid_owner"]
  },
  "identities": [
    {
      "platform": "qq",
      "user_id": "1000000000",
      "role": "大肥鱼",
      "note": "主人 / QQ 管理员"
    },
    {
      "platform": "wechat",
      "user_id": "wxid_owner",
      "role": "女仆",
      "note": "主人 / 微信管理员"
    }
  ],
  "harness": {
    "dsh_root": "dsh",
    "dsh_home": "",
    "timeout_s": 180,
    "max_parallel": 3,
    "dotenv": [
      ".env",
      "services/brain/.env"
    ]
  },
  "roles": {
    "大肥鱼": {
      "display": "大肥鱼",
      "profile": "brain-dafeiyu",
      "credential": {"mode": "account"},
      "model": "deepseek-flash",
