      "persona_files": ["stack/persona-大肥鱼.md"],
      "workspace": "services/brain/workspaces/brain-dafeiyu"
    },
    "桌宠": {
      "display": "桌宠",
      "profile": "brain-pet",
      "credential": {"mode": "account"},
      "model": "deepseek-flash",
      "reasoning_effort": "low",
      "persona_files": ["stack/persona-桌宠.md"],
      "workspace": "services/brain/workspaces/brain-pet"
    },
    "女仆": {
      "display": "女仆",
      "profile": "brain-maid",
      "credential": {"mode": "api_key", "env": "DEEPSEEK_API_KEY_MAID"},
      "model": "deepseek-flash",
      "reasoning_effort": "medium",
      "persona_files": [
        "stack/persona-大肥鱼.md",
        "stack/persona-女仆强化.md"
      ],
      "workspace": "services/brain/workspaces/brain-maid"
